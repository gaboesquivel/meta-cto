# Vercel AI Gateway — preferred for /api/chat, /api/operator/chat, and GenUI tier-3 compose
AI_GATEWAY_API_KEY=

# Optional chat / GenUI model ids (Gateway provider strings, e.g. anthropic/claude-sonnet-4.6)
# CHAT_MODEL=anthropic/claude-sonnet-4-20250514
# GENUI_MODEL=anthropic/claude-sonnet-4.6

# Local-only direct Anthropic override (not for CI); requires ANTHROPIC_API_KEY
# FLOW_ALLOW_DIRECT_ANTHROPIC=1
ANTHROPIC_API_KEY=

# Optional Eve agent models (defaults anthropic/claude-sonnet-4-20250514)
# EVE_AGENT_MODEL=
# EVE_OPERATOR_MODEL=

# Operator (protected surfaces) — min 16 characters; unset disables Operator fail-closed
OPERATOR_SECRET=
# Deprecated alias (flow-next only): OPERATOR_ACCESS_TOKEN=

# Pilot Key (spec 003) — min 16 characters. Callers send it as the x-signal-pilot-key header on
# REST and /api/mcp to act on the Pilot Workspace; unset disables every pilot read and write.
SIGNAL_PILOT_KEY=
# Private pilot data (spec 004) — absolute path to a folder OUTSIDE this repository holding the
# filled pilot files (pilot/manifest.json, backlog.json, feedback.json, answer-key.json) and the
# Held-Out Set v2 pairs (evals/held-out-v2.json). Read by signal:pilot:check/freeze/load and the
# v2 eval freeze/run; a folder inside the git working tree is refused. Never commit its content.
# SIGNAL_PRIVATE_DATA_DIR=/Users/you/signal-private
# Blind Review share (0 to 1) of new Feature Requests: pilot defaults to 0.3, demo to 0.
# SIGNAL_PILOT_BLIND_SHARE=0.3
# SIGNAL_DEMO_BLIND_SHARE=0

# Skip curated skills install during pnpm setup
# FLOW_SETUP_SKIP_SKILLS=1
